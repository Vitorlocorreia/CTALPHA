# ==============================================================================
# CT ALPHA HUB — ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# ==============================================================================
# Configure these variables in your Vercel Project Settings -> Environment Variables
# or locally in a .env file (DO NOT commit .env with real private keys to git).

# Supabase Production Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Safe for client-side / browser usage)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application Environment Mode ('production' | 'development' | 'staging')
VITE_APP_ENV=production
